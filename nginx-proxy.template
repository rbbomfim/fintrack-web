# Repassa /api/* para o backend, mantendo tudo na mesma origem do frontend.
# Como o navegador nunca faz requisição cross-origin, não há preflight nem CORS:
# some toda uma classe de falha (PUBLIC_API_BASE_URL errado, extensão ou proxy
# corporativo mexendo no preflight, backend sem a origem em BACKEND_CORS_ORIGINS).
location /api/ {
    proxy_pass __API_PROXY_TARGET__/;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;

    add_header Cache-Control "no-store";
}
