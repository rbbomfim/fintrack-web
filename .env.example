FRONTEND_PORT=3011

# --- Modo same-origin (recomendado) ---
# Endereco do backend visto de DENTRO do container do frontend.
# O nginx repassa /api para ca, entao o navegador nunca faz cross-origin:
# sem preflight, sem CORS, imune a extensao/proxy mexendo no preflight.
API_PROXY_TARGET=http://192.168.3.12:8011
PUBLIC_API_BASE_URL=/api

# --- Modo direto (legado) ---
# Deixe API_PROXY_TARGET vazio e informe a URL publica do backend.
# Exige BACKEND_CORS_ORIGINS no backend com a URL do frontend.
# API_PROXY_TARGET=
# PUBLIC_API_BASE_URL=http://192.168.3.12:8011
